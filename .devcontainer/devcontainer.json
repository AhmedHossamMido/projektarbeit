{
  "name": "SciPro Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "pip install -r /workspaces/$(basename ${GITHUB_REPOSITORY})/requirements.txt && py pyflyby.install_in_ipython_config_file",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "jovyan",
  "settings": {
    "terminal.integrated.profiles.linux": {
      "bash (conda base)": {
        "path": "/bin/bash",
        "args": [
          "-c",
          "conda activate base && exec bash"
        ]
      }
    },
    "terminal.integrated.defaultProfile.linux": "bash (conda base)"
  }
}
